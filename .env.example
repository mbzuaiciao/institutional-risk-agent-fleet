# Gemini API path (use one credential mechanism; never commit real values)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Optional Vertex AI path
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Bounded model execution
RISK_FLEET_PROVIDER=offline
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=1
RISK_FLEET_DETERMINISTIC_FALLBACK=false

# Cloud infrastructure mode
APP_ENV=local
STATE_STORE=memory
FIRESTORE_DATABASE=(default)
PUBSUB_TOPIC=risk-events
WORKER_URL=
WORKER_AUTH=true
DEMO_RESET_ENABLED=true
EVENT_POLL_SECONDS=1
EVENT_POLL_TIMEOUT_SECONDS=90
SERVICE_MODE=worker
